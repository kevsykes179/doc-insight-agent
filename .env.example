# Copy this file to .env and fill in your key. .env is git-ignored, so the key is never committed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: pin specific models. If left blank, the newest Sonnet (main) and Haiku (extraction) are auto-detected.
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=

# Optional: point at a different folder of documents.
# DATA_DIR=data
